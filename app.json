{
  "expo": {
    "name": "School Management",
    "slug": "schoolmanagementmobileapp",
    "icon": "./assets/images/icon.png",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "adaptiveIcon": {
              "backgroundColor": "#E6F4FE",
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundImage": "./assets/images/android-icon-background.png",
              "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "newArchEnabled": true,
            "minSdkVersion": 28
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "We need access to your camera to enable face login.",
          "microphonePermissionText": "We need access to your microphone for recognition.",
          "enableFrameProcessors": true
        }
      ]
    ],
    "android": {
      "package": "com.nishanth_sekar.school_management_mobile_app2",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "c4165589-4248-4155-9ec0-8c6bc8c958fe"
      },
      "apiUrl": "https://schoolglobalserver-agsoft.onrender.com",
      "razorpayKeyId": "rzp_live_Rt5vLcnxGaTs8Y"
    }
  }
}